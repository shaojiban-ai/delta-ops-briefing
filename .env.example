# ============================================================
#  国际服官方「密码门」接口 token 配置
#  抓包对象：playdeltaforce.com HQ 的 DfTools/GetPrivateRoomKey 请求
#  注意：本文件是示例，真实 token 写进 .env（已被 .gitignore 忽略），
#        云端则写进 GitHub Actions 的 Secrets，切勿提交到仓库。
# ============================================================

# 方式 1（推荐）：把 DevTools "Copy as cURL" 的请求整理成一段 JSON。
# 包含 url / method / headers（含 Authorization 或 Cookie）/ body。
# DF_REQ_JSON={"url":"https://www.playdeltaforce.com/api/proxy/logicial/DfTools/GetPrivateRoomKey","method":"POST","headers":{"Content-Type":"application/json","Authorization":"Bearer xxx","Cookie":"xxx"},"body":"{}"}

# 方式 2：分字段写（与方式 1 二选一）
# DF_URL=https://www.playdeltaforce.com/api/proxy/logicial/DfTools/GetPrivateRoomKey
# DF_METHOD=POST
# DF_HEADERS={"Content-Type":"application/json","Authorization":"Bearer xxx","Cookie":"xxx"}
# DF_BODY={}
